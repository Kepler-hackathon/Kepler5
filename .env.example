# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/keplerlearn

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=kepler-dev

# Bedrock model inference profile ARNs
BEDROCK_MODEL_MAIN=us.anthropic.claude-sonnet-4-5-20251001-v1:0
BEDROCK_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# S3
UPLOADS_BUCKET=
ASSETS_BUCKET=
ASSETS_CDN_URL=
NEXT_PUBLIC_ASSETS_CDN_URL=

# SQS / Step Functions
JOBS_QUEUE_URL=
PROCESS_MODULE_STATE_MACHINE_ARN=

# App config
UPVOTE_THRESHOLD=5
DEMO_MODE=true
ADMIN_TOKEN=changeme

# Kill switch — set to "true" to return 503 on all AI-touching routes
AI_DISABLED=false

# Local dev: run the generator/deck-parser workers as plain local calls/processes instead of
# going through SQS/Step Functions/Lambda. S3 and Bedrock calls still hit real AWS. See
# apps/web/src/lib/local-worker.ts. Requires workers/deck-parser/scripts/setup-venv.sh to
# have been run once.
LOCAL_WORKERS=false
