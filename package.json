{
  "name": "keplerlearn",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "postinstall": "node scripts/fix-drizzle.mjs",
    "dev": "pnpm --filter @kepler/web dev",
    "build": "pnpm --filter @kepler/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @kepler/db db:generate",
    "db:migrate": "pnpm --filter @kepler/db db:migrate",
    "db:studio": "pnpm --filter @kepler/db db:studio"
  }
}
